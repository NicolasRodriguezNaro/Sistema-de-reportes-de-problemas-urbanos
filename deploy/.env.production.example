# Copia este archivo como deploy/.env y completa los valores.
# No lo subas a Git.

DB_NAME=gestion_db
DB_USER=gestion
DB_PASSWORD=CAMBIAME_POR_UNA_CLAVE_LARGA

MINIO_ROOT_USER=gestion
MINIO_ROOT_PASSWORD=CAMBIAME_POR_OTRA_CLAVE_LARGA
FUSEKI_ADMIN_PASSWORD=CAMBIAME_POR_LA_CLAVE_DEL_ADMIN_DE_FUSEKI

JWT_SECRET=CAMBIAME_POR_64_CARACTERES_ALEATORIOS
GEMINI_API_KEY=CAMBIAME_POR_LA_API_KEY

# Correo transaccional (Brevo). Verifica el dominio y crea una API key.
CORREO_PROVEEDOR=brevo
BREVO_API_KEY=CAMBIAME_POR_LA_API_KEY_DE_BREVO
CORREO_REMITENTE=no-reply@mosqueteros.cloud
CORREO_REMITENTE_NOMBRE=Reporte Urbano

APP_URL=https://reportes.mosqueteros.cloud
S3_URL=https://s3.mosqueteros.cloud
CORS_ORIGINS=https://reportes.mosqueteros.cloud
